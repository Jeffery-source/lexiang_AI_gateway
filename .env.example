# Redis 用于共享 access_token、凭证状态和多轮会话。
REDIS_URL=redis://localhost:6379/0

# 乐享接口凭证池，格式：内部凭证ID:AppKey:AppSecret:权限组
# 多套凭证用英文逗号分隔。同一权限组的凭证必须拥有相同的 AI 权限与知识范围。
LEXIANG_CREDENTIALS=primary:YOUR_APP_KEY_1:YOUR_APP_SECRET_1:default,secondary:YOUR_APP_KEY_2:YOUR_APP_SECRET_2:default

# 这是你自己定义、发给调用方的网关 API Key，不是乐享的 access_token。
# 建议使用至少 32 字节的随机值；多个 Key 用英文逗号分隔。
GATEWAY_API_KEYS=REPLACE_WITH_A_LONG_RANDOM_GATEWAY_KEY

# OpenAI 兼容接口调用乐享时使用的成员身份。
# system-bot 仅可访问公开知识；如需私有知识，填写具有相应权限的乐享成员帐号。
LEXIANG_STAFF_ID=system-bot

# OpenAI 兼容接口暴露的模型名称。
OPENAI_COMPAT_MODEL=lexiang-ai

# 可选：跨域白名单。多个来源用英文逗号分隔；留空表示不启用 CORS。
# ALLOWED_ORIGINS=https://your-frontend.example.com

# token 距离过期多少秒时提前刷新，避免请求中途失效。
TOKEN_EXPIRY_SKEW_SECONDS=300

# 会话映射在 Redis 中的保存时间（默认 30 天）。
CONVERSATION_TTL_SECONDS=2592000

# 获取乐享 token 遇到 429 后，当前凭证的冷却时间。
CREDENTIAL_COOLDOWN_SECONDS=600

# 请求乐享上游接口的超时时间。
UPSTREAM_TIMEOUT_SECONDS=90
